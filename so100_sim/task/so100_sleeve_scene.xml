      <geom name="rod_post_geom" type="box" size="0.018 0.012 0.0425" material="rod_base_mat" friction="1 0.005 0.0001"/>
    </body>
    <body name="rod_rest" pos="-0.06 -0.20 0.085" quat="0.707105 -0.707108 0 0">
      <geom name="rod_base_geom" type="cylinder" size="0.009 0.004" pos="0 0 0.004"
        material="rod_base_mat" friction="1 0.005 0.0001"/>
      <geom name="rod_geom" type="cylinder" size="0.004 0.036" pos="0 0 0.036"
        material="rod_mat" friction="0.8 0.005 0.0001"/>
      <geom name="rod_tip_cap" type="sphere" size="0.004" pos="0 0 0.072"
